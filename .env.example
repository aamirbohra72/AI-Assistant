# Copy to .env and fill in. Never commit .env.
ENV=development
LOG_LEVEL=INFO
PUBLIC_BASE_URL=https://your-service.onrender.com

# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=
INTERNAL_API_TOKEN=
STREAM_TOKEN_SECRET=

DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
REDIS_URL=rediss://default:PASSWORD@YOUR-UPSTASH-HOST.upstash.io:6379

GEMINI_API_KEY=
GEMINI_FLASH_MODEL=gemini-flash-latest
GEMINI_PRO_MODEL=gemini-pro-latest
GEMINI_SCORING_FALLBACK_MODEL=gemini-3.7-flash

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15555550123

DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

INTERVIEWER_NAME=Alex
COMPANY_NAME=Acme Corp

# Tuning (defaults shown)
VAD_SILENCE_MS=600
BARGE_IN_MS=500
RESPONSE_DELAY_MIN_MS=300
RESPONSE_DELAY_MAX_MS=700
RUN_WORKER_IN_WEB=true
WORKER_POLL_SECONDS=30
